{
  "name": "jdbc-sink-connector",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "connection.url": "jdbc:postgresql://postgres-target:5432/analytics",
    "connection.username": "target",
    "connection.password": "target",
    "topics": "cdc.transformed.orders,cdc.transformed.customers,cdc.transformed.products,cdc.transformed.order_items",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "schema.evolution": "basic",
    "auto.evolve": "true",
    "database.timezone": "UTC",
    "decimal.handling.mode": "double"
  }
}
